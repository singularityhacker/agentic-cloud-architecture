{
  "schema_version": 1,
  "name": "enterprise-research",
  "scenario": "Research a synthetic customer's refund and retention policies using tools and persistent context.",
  "capabilities": {
    "model": {
      "provider": "ollama",
      "name": "llama3.2:3b"
    },
    "runtime": {
      "type": "tool-using-agent"
    },
    "memory": {
      "type": "persistent",
      "scope": "session"
    },
    "retrieval": {
      "type": "document_search"
    },
    "tools": [
      "search_docs",
      "lookup_customer",
      "remember",
      "recall"
    ],
    "policy": {
      "default": "deny",
      "allowed_tools": [
        "search_docs",
        "lookup_customer",
        "remember",
        "recall"
      ]
    },
    "observability": {
      "traces": true
    }
  },
  "limits": {
    "max_model_turns": 6,
    "max_tool_calls": 12
  },
  "evaluation": {
    "fixture": "fixtures/enterprise_research.json"
  },
  "targets": {
    "local": {
      "provider": "docker-compose"
    },
    "aws": {
      "provider": "agentcore",
      "status": "planned"
    }
  }
}
